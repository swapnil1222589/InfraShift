APP_NAME=InfraShift
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Mode Flags ---
# Set LOCAL_MODE=true for local development (no AWS credentials needed)
LOCAL_MODE=true
LIVE_AWS=false

# Set MOCK_AI=false when real AI adapter is implemented
MOCK_AI=true

# Set MOCK_GITHUB=false when real GitHub token is configured
MOCK_GITHUB=true

# --- AWS Configuration ---
AWS_REGION=us-east-1

# --- DynamoDB Tables ---
DYNAMODB_PROJECTS_TABLE=infrashift-projects
DYNAMODB_ANALYSES_TABLE=infrashift-analyses
DYNAMODB_AUDIT_TABLE=infrashift-audit-events

# --- GitHub Integration ---
# Required when MOCK_GITHUB=false
GITHUB_TOKEN=
# Required for webhook signature validation (recommended)
GITHUB_WEBHOOK_SECRET=

# --- Frontend CORS Origins ---
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Timeouts ---
GITHUB_TIMEOUT_SECONDS=10
AWS_TIMEOUT_SECONDS=10
AI_TIMEOUT_SECONDS=30

# --- CloudWatch ---
CLOUDWATCH_LOOKBACK_DAYS=7

# --- Auto-create project from webhook (optional) ---
AUTO_CREATE_PROJECT=false
